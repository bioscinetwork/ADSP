# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.pytest_tmp*/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDE / Editor Metadata
.idea/
.vscode/
*.swp
*.swo
*~

# Runtime logs & temporary files
*.log
tmp/
temp/

# Generated docking results and intermediate files
results/**
reports/**
logs/**
*.dlg
*.glg
*.map
*.fld
*.xyz
*.dpf
*.gpf

# Temporary spreadsheet exports
reports/*.xlsx
reports/*.csv
results/*.xlsx
results/*.csv

# Keep directory scaffolding and READMEs in results/reports/logs if present
!results/.gitkeep
!reports/.gitkeep
!logs/.gitkeep
